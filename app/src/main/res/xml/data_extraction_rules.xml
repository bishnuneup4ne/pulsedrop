<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules for API 31+ (used with android:dataExtractionRules).
   A missing section falls back to "back up everything", so the exclusions are
   repeated for cloud-backup and device-transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="localdrop_identity.xml" />
        <exclude domain="sharedpref" path="localdrop_pairs.xml" />
        <exclude domain="sharedpref" path="localdrop_settings.xml" />
        <exclude domain="external" path="WebDrop_Received" />
        <exclude domain="external" path="WebDrop_Chat" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="localdrop_identity.xml" />
        <exclude domain="sharedpref" path="localdrop_pairs.xml" />
        <exclude domain="sharedpref" path="localdrop_settings.xml" />
        <exclude domain="external" path="WebDrop_Received" />
        <exclude domain="external" path="WebDrop_Chat" />
    </device-transfer>
</data-extraction-rules>
